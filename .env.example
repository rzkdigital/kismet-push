# ---- Identificacao do terminal ----
ID_PONTO=10
SERVIDOR=12321
# Fuso usado em todo horario que o servico gera (coletado_em, janela, logs,
# nomes de arquivo e de pasta). Independe do fuso do sistema operacional.
TIMEZONE=America/Sao_Paulo

# ---- Kismet ----
KISMET_URL=http://127.0.0.1:2501
# Use a API key (preferencial) OU usuario/senha
KISMET_API_KEY=
KISMET_USER=kismet
KISMET_PASSWORD=kismet
# Tipo de dispositivo a coletar (kismet.device.base.type)
KISMET_DEVICE_TYPE=Wi-Fi Client
# Corte de sinal em dBm: so entra quem estiver MAIS FORTE que este valor
# (-84 entra, -85 nao entra). Usa kismet.common.signal.last_signal.
SINAL_MINIMO_DBM=-85
# Device sem leitura de sinal utilizavel (sem dBm, ou last_signal = 0):
# false descarta, true mantem no lote
MANTER_SEM_LEITURA_DE_SINAL=false
# Remove os blocos de historico circular (kismet.common.rrd.*) do registro.
# Nos lotes eles vem da placa de captura, repetidos em todo device, e nao dizem
# nada sobre o aparelho visto. false mantem o registro 100% cru.
REMOVER_RRD=true
# Pede o filtro de tipo ja no servidor Kismet (regex). Se o build do Kismet nao
# tiver suporte a regex, o app detecta o erro e passa a filtrar localmente.
KISMET_SERVER_SIDE_FILTER=true
# Segundos de sobreposicao entre coletas, evita perder device na virada do minuto
KISMET_OVERLAP_SECONDS=10
# Janela usada na primeira coleta apos subir o processo (segundos)
KISMET_FIRST_WINDOW_SECONDS=300
KISMET_TIMEOUT_MS=30000

# ---- API central (destino) ----
UPSTREAM_URL=https://api.exemplo.com.br/kismet/registros
UPSTREAM_TOKEN=
UPSTREAM_TIMEOUT_MS=30000
# Compressao do corpo (Content-Encoding: gzip). So ligue depois de confirmar que
# a API central descomprime o request — Nginx na frente NAO faz isso sozinho.
# Se ela recusar (415/400), o servico reenvia sem gzip e desativa ate reiniciar.
UPSTREAM_GZIP=false
UPSTREAM_GZIP_LEVEL=6
UPSTREAM_GZIP_MIN_BYTES=1024

# ---- Pasta local de lotes (enquanto a API central nao existe) ----
# auto   = grava na pasta so enquanto UPSTREAM_URL estiver vazia
# sempre = grava uma copia local mesmo mandando para a API
# nunca  = so a API
SAIDA_LOCAL=auto
SAIDA_LOCAL_DIR=./data/lotes
# JSON identado (mais facil de ler/analisar) ou minificado
SAIDA_LOCAL_IDENTADO=true

# ---- Agendamento ----
CRON_COLETA=*/1 * * * *
CRON_REENVIO=*/2 * * * *
# Envia lote mesmo quando nenhum device foi visto no intervalo
ENVIAR_LOTE_VAZIO=false

# ---- Fila offline ----
SPOOL_DIR=./data/spool
SPOOL_MAX_LOTES=5000
SPOOL_MAX_DIAS=7
# Quantos lotes tenta reenviar por rodada de flush
SPOOL_FLUSH_BATCH=20

# ---- MACs extras a ignorar (alem das interfaces do proprio Kismet) ----
EXCLUDE_MACS=

# ---- HTTP local ----
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
