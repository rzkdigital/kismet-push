{
  "name": "kismet-push",
  "version": "1.0.0",
  "description": "Coleta dispositivos Wi-Fi Client do Kismet a cada 1 minuto, monta o payload e envia para a API central, com fila offline em disco.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "mock:upstream": "tsx scripts/mock-upstream.ts",
    "mock:kismet": "tsx scripts/mock-kismet.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "fastify-cron": "^1.4.0",
    "pino-pretty": "^13.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
